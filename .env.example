# Use the Supabase project URL, not the REST endpoint.
# Example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public Cloudflare Turnstile site key for signup CAPTCHA when enabled in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public canonical origin used by metadata, robots.txt, and sitemap.xml.
# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_LINK=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_LINK=
NEXT_PUBLIC_STRIPE_SETUP_ASSIST_LINK=
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
ADMIN_EMAILS=
